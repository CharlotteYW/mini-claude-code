# LLM — project defaults (override freely)
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:31b

# Ollama (host process; not started by docker compose)
OLLAMA_BASE_URL=http://localhost:11434
# Large model (~20GB): do NOT auto-pull in setup.
# Opt in: PULL_OLLAMA_MODEL=1 ./scripts/setup.sh

# Anthropic (Messages API)
ANTHROPIC_API_KEY=
# Example when using Anthropic:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1

# OpenRouter (OpenAI-compatible gateway — same protocol, different base_url)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://localhost
OPENROUTER_X_TITLE=mini-claude-code
# LLM_PROVIDER=openrouter
# LLM_MODEL=anthropic/claude-sonnet-4

# Infrastructure (docker compose)
POSTGRES_USER=mcc
POSTGRES_PASSWORD=mcc
POSTGRES_DB=mini_claude_code
DATABASE_URL=postgresql://mcc:mcc@localhost:5432/mini_claude_code

NEO4J_USER=neo4j
NEO4J_PASSWORD=mini-claude-code
NEO4J_URI=bolt://localhost:7687
# Browser UI: http://localhost:7474

# Agent filesystem workspace (M3 path jail). Empty → <repo>/workspace
WORKSPACE_ROOT=

# Host shell timeout seconds. Isolation: SHELL_BACKEND=docker (M11 default).
SHELL_TIMEOUT_SEC=30
# run_shell backend: docker (ephemeral container) | host (unsafe subprocess)
SHELL_BACKEND=docker
SHELL_DOCKER_IMAGE=python:3.12-slim
# Teaching default: no egress from the sandbox container
SHELL_DOCKER_NETWORK=none

# Session checkpointer (M5): postgres (durable) or memory (process-local)
CHECKPOINT_BACKEND=postgres

# Context compaction (M7). Tokens ≈ chars/4. threshold<=0 disables.
CONTEXT_COMPACT_THRESHOLD=6000
CONTEXT_KEEP_RECENT=12

# Semantic notes / pgvector (M8-B). Pull once: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Plan Mode (M9): 1/true → deny mutating tools (read-only). CLI --plan also enables.
# Ask tools (M10) use LangGraph interrupt + checkpointer; non-plan CLI auto-allocates thread_id.
AGENT_PLAN_MODE=0

# MCP client (M14). Off by default. Priority: MCP_CONFIG_PATH > MCP_CONFIG > MCP_USE_DEMO.
# Teaching shortcut (in-repo stdio echo_math server: echo + add):
# MCP_USE_DEMO=1
MCP_USE_DEMO=0
# Or inline JSON (paths must be absolute for stdio args):
# MCP_CONFIG={"echo_math":{"transport":"stdio","command":"python","args":["/abs/path/to/echo_math.py"]}}
# Or a JSON file:
# MCP_CONFIG_PATH=/abs/path/to/mcp.servers.json
MCP_CONFIG=
MCP_CONFIG_PATH=

# Lifecycle hooks (M15). Priority: HOOKS_CONFIG_PATH > workspace/hooks.yaml > HOOKS_USE_DEMO.
# Teaching shortcut (block dangerous shell substrings + post audit/redact + stop log):
# HOOKS_USE_DEMO=1
HOOKS_USE_DEMO=0
# Or copy workspace/hooks.example.yaml → workspace/hooks.yaml
# Or absolute path:
# HOOKS_CONFIG_PATH=/abs/path/to/hooks.yaml
HOOKS_CONFIG_PATH=

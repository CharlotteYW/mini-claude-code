# LLM — project defaults (override freely)
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:31b

# Ollama (host process; not started by docker compose)
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic (Messages API)
ANTHROPIC_API_KEY=
# Example: claude-sonnet-4-20250514 — set LLM_PROVIDER=anthropic and LLM_MODEL=...

# OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=   # optional override

# OpenRouter (OpenAI-compatible gateway)
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter headers (recommended by OpenRouter):
# OPENROUTER_HTTP_REFERER=https://localhost
# OPENROUTER_X_TITLE=mini-claude-code

# Infrastructure (filled when M0 compose is implemented)
POSTGRES_USER=mcc
POSTGRES_PASSWORD=mcc
POSTGRES_DB=mini_claude_code
DATABASE_URL=postgresql://mcc:mcc@localhost:5432/mini_claude_code

NEO4J_USER=neo4j
NEO4J_PASSWORD=mini-claude-code
NEO4J_URI=bolt://localhost:7687

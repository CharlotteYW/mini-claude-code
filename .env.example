# LLM — project defaults (override freely)
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:31b

# Ollama (host process; not started by docker compose)
OLLAMA_BASE_URL=http://localhost:11434
# Large model (~20GB): do NOT auto-pull in setup.
# Opt in: PULL_OLLAMA_MODEL=1 ./scripts/setup.sh

# Anthropic (Messages API)
ANTHROPIC_API_KEY=
# Example when using Anthropic:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1

# OpenRouter (OpenAI-compatible gateway — same protocol, different base_url)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://localhost
OPENROUTER_X_TITLE=mini-claude-code
# LLM_PROVIDER=openrouter
# LLM_MODEL=anthropic/claude-sonnet-4

# Infrastructure (docker compose)
POSTGRES_USER=mcc
POSTGRES_PASSWORD=mcc
POSTGRES_DB=mini_claude_code
DATABASE_URL=postgresql://mcc:mcc@localhost:5432/mini_claude_code

NEO4J_USER=neo4j
NEO4J_PASSWORD=mini-claude-code
NEO4J_URI=bolt://localhost:7687
# Browser UI: http://localhost:7474

# Elasticsearch full-text (M21). Compose service mcc-elasticsearch.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=mcc_chunks

# Agent filesystem workspace (M3 path jail). Empty → <repo>/workspace
WORKSPACE_ROOT=

# Host shell timeout seconds. Isolation: SHELL_BACKEND=docker (M11 default).
SHELL_TIMEOUT_SEC=30
# run_shell backend: docker (ephemeral container) | host (unsafe subprocess)
SHELL_BACKEND=docker
SHELL_DOCKER_IMAGE=python:3.12-slim
# Teaching default: no egress from the sandbox container
SHELL_DOCKER_NETWORK=none

# Session checkpointer (M5): postgres (durable) or memory (process-local)
CHECKPOINT_BACKEND=postgres

# Context compaction (M7). Tokens ≈ chars/4. threshold<=0 disables.
CONTEXT_COMPACT_THRESHOLD=6000
CONTEXT_KEEP_RECENT=12

# Semantic notes / pgvector (M8-B). Pull once: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Plan Mode (M9): 1/true → deny mutating tools (read-only). CLI --plan also enables.
# Ask tools (M10) use LangGraph interrupt + checkpointer; non-plan CLI auto-allocates thread_id.
AGENT_PLAN_MODE=0

# MCP client (M14). Off by default. Priority: MCP_CONFIG_PATH > MCP_CONFIG > demo flags.
# Teaching shortcut (in-repo stdio echo_math server: echo + add):
# MCP_USE_DEMO=1
MCP_USE_DEMO=0
# M26 fake docs MCP (list_docs / read_doc + server content policy):
# MCP_USE_FAKE_DOCS=1
MCP_USE_FAKE_DOCS=0
# Or inline JSON (paths must be absolute for stdio args):
# MCP_CONFIG={"echo_math":{"transport":"stdio","command":"python","args":["/abs/path/to/echo_math.py"]}}
# Or a JSON file:
# MCP_CONFIG_PATH=/abs/path/to/mcp.servers.json
MCP_CONFIG=
MCP_CONFIG_PATH=

# Content policy (M26). Screen read_doc / read_file results for markers in title/first line.
CONTENT_POLICY_ENABLED=1
CONTENT_POLICY_MARKERS=no-ai,CONFIDENTIAL
CONTENT_POLICY_WRAP_BUILTIN_READ=1

# Plugin packs (M16–M25). Scan workspace/plugins/*/plugin.yaml when enabled.
PLUGINS_ENABLED=1
# Install/trust CLI: mcc-plugins install|list|trust|disable
# Trust file: workspace/plugins/.trust.yaml (local; gitignored)

# Lifecycle hooks (M15). Priority: HOOKS_CONFIG_PATH > workspace/hooks.yaml > HOOKS_USE_DEMO.
# Teaching shortcut (block dangerous shell substrings + post audit/redact + stop log):
# HOOKS_USE_DEMO=1
HOOKS_USE_DEMO=0
# Or copy workspace/hooks.example.yaml → workspace/hooks.yaml
# Or absolute path:
# HOOKS_CONFIG_PATH=/abs/path/to/hooks.yaml
HOOKS_CONFIG_PATH=

# M24 shell/script hooks (deny-by-default). Paths under workspace/plugins/ are
# allowed when enabled; otherwise set HOOK_SHELL_ALLOWLIST to absolute paths.
# HOOK_SHELL_ENABLED=1
HOOK_SHELL_ENABLED=0
HOOK_SHELL_ALLOWLIST=
# HOOK_SHELL_TIMEOUT_SEC=5

# LLM retry / usage (M17)
# LLM_MAX_RETRIES=3
# LLM_RETRY_BACKOFF_SEC=1.0
# USAGE_REPORT=0

# Slack channel adapter (M18). OAuth install → workspace/slack_installations.json
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# SLACK_APP_TOKEN=          # App-level token (connections:write) for Socket Mode
# Use 127.0.0.1 + a free port — Docker often occupies localhost:3000 on macOS.
# SLACK_OAUTH_REDIRECT_URI=http://127.0.0.1:3917/slack/oauth/callback
# SLACK_OAUTH_PORT=3917
# SLACK_BOT_TOKEN=          # optional override instead of installation file
# SLACK_BOT_USER_ID=        # optional; strips <@bot> mentions
# SLACK_CHANNEL_ALLOWLIST=  # comma-separated channel ids; empty = all
# CHANNEL_PLAN_MODE=1       # default read-only for Slack bot (deny mutating tools)
# SLACK_PROGRESS_EMOJI=eyes # reaction on your message while agent runs (needs reactions:write)

# GitHub PR tool (M18). Token only — no GitHub OAuth in this milestone.
# GH_TOKEN=
# PR_DRY_RUN=1              # 1 = dry-run (default); 0 = live create when GH_TOKEN set

# Pre-ship quality gate (M19)
# SHIP_REQUIRE_GREEN=1      # block open_pull_request until ship_check passed
# SHIP_MAX_FIX_ITERS=3      # consecutive failed ship_check budget
# SHIP_MODE=pr              # pr (default) | push (also registers git_push, ask + green)

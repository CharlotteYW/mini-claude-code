# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
*.egg-info/

# Env / secrets
.env
.env.local

# OS / IDE
.DS_Store
.idea/
.vscode/

# Node (frontend later)
node_modules/
frontend/dist/

# LangGraph / local artifacts
*.log
.coverage
htmlcov/

# Agent workspace scratch (M3+); keep README + AGENT.md + example subagents
workspace/*
!workspace/README.md
!workspace/AGENT.md
!workspace/subagents/
!workspace/subagents/*.yaml
!workspace/subagents/*.yml
!workspace/skills/
!workspace/skills/*/
!workspace/skills/*/SKILL.md
!workspace/hooks.example.yaml
!workspace/docs/
!workspace/docs/*.md
!workspace/plugins/
!workspace/plugins/*/
!workspace/plugins/**/
!workspace/plugins/**/*.yaml
!workspace/plugins/**/*.yml
!workspace/plugins/**/*.md
!workspace/plugins/**/SKILL.md
